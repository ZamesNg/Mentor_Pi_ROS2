#!/usr/bin/env bash

set -euo pipefail

systemctl_path="/usr/bin/systemctl"

Fail() {
  echo "Mentor Pi deployment idle guard error: $*" >&2
  exit 1
}

while (($# > 0)); do
  case "$1" in
    --systemctl)
      (($# >= 2)) || Fail "--systemctl requires a path"
      systemctl_path="$2"
      shift 2
      ;;
    *)
      Fail "unknown argument: $1"
      ;;
  esac
done

[[ -x "${systemctl_path}" ]] ||
  Fail "systemctl executable is missing at ${systemctl_path}"

query_status=0
state="$("${systemctl_path}" show \
  --property=LoadState --property=ActiveState \
  mentor-pi-controller.target 2>/dev/null)" || query_status=$?
if ((query_status != 0)); then
  Fail "could not query mentor-pi-controller.target (systemctl status ${query_status})"
fi

load_state="$(sed -n 's/^LoadState=//p' <<<"${state}")"
active_state="$(sed -n 's/^ActiveState=//p' <<<"${state}")"
[[ -n "${load_state}" && "${load_state}" != *$'\n'* ]] ||
  Fail "systemctl returned an invalid LoadState"
[[ -n "${active_state}" && "${active_state}" != *$'\n'* ]] ||
  Fail "systemctl returned an invalid ActiveState"
case "${load_state}" in
  loaded | not-found) ;;
  *) Fail "unexpected controller target LoadState=${load_state}" ;;
esac
if [[ "${active_state}" != "inactive" ]]; then
  Fail "controller target must be inactive; ActiveState=${active_state}"
fi

echo "Verified mentor-pi-controller.target is inactive (${load_state})."
