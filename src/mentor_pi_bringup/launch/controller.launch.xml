<?xml version="1.0"?>
<launch>
  <arg name="serial_device" default="/dev/mentor_pi_mcu"/>
  <arg name="config_file"
       default="$(find-pkg-share mentor_pi_bringup)/config/controller.yaml"/>
  <arg name="agent_verbosity" default="4"/>
  <arg name="agent_executable"
       default="/opt/mentor_pi/bin/mentor_pi_micro_ros_agent"/>

  <executable
    cmd="$(var agent_executable) serial --dev $(var serial_device) --baudrate 1000000 -v$(var agent_verbosity)"
    name="micro_ros_agent"
    output="screen"/>

  <node pkg="mentor_pi_bringup"
        exec="configuration_supervisor"
        output="screen">
    <param from="$(var config_file)"/>
  </node>
</launch>
