#!/usr/bin/env bash

set -euo pipefail

readonly ROS_SETUP="${MENTOR_PI_ROS_SETUP:-/opt/mentor_pi/host/setup.bash}"
readonly SUPERVISOR_EXECUTABLE="${MENTOR_PI_SUPERVISOR_EXECUTABLE:-/opt/mentor_pi/host/lib/mentor_pi_bringup/configuration_supervisor}"
readonly CONTROLLER_CONFIG="${MENTOR_PI_CONTROLLER_CONFIG:-/etc/mentor-pi/controller.yaml}"

ValidateRosIdentity() {
  if [[ ! "${ROS_DOMAIN_ID:-}" =~ ^(0|[1-9][0-9]{0,2})$ ]] ||
      ((ROS_DOMAIN_ID > 232)); then
    echo "ROS_DOMAIN_ID must be explicitly set to an integer in [0, 232]." \
      >&2
    exit 1
  fi
}

if [[ ! -r "${ROS_SETUP}" ]]; then
  echo "Mentor Pi ROS setup is not readable: ${ROS_SETUP}" >&2
  exit 1
fi
if [[ ! -x "${SUPERVISOR_EXECUTABLE}" ]]; then
  echo "Mentor Pi configuration supervisor is not executable: " \
    "${SUPERVISOR_EXECUTABLE}" >&2
  exit 1
fi
if [[ ! -r "${CONTROLLER_CONFIG}" ]]; then
  echo "Mentor Pi controller configuration is not readable: " \
    "${CONTROLLER_CONFIG}" >&2
  exit 1
fi

# Generated ROS environment hooks are not guaranteed to be nounset-clean.
# They execute only during process startup; exec then replaces this shell with
# the project-owned C++ supervisor.
set +u
source "${ROS_SETUP}"
set -u

ValidateRosIdentity

exec "${SUPERVISOR_EXECUTABLE}" --ros-args \
  --params-file "${CONTROLLER_CONFIG}"
