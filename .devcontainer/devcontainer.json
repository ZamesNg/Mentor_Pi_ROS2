{
  "name": "Mentor Pi ROS 2 Humble",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "mentor",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "ROS_DISTRO": "humble",
    "ROS_DOMAIN_ID": "0"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
