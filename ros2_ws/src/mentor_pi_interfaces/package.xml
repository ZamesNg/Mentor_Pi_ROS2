<?xml version="1.0"?>
<package format="3">
  <name>mentor_pi_interfaces</name>
  <version>0.1.0</version>
  <description>Bounded ROS 2 interfaces for the Mentor Pi controller v2.</description>

  <maintainer email="maintainers@mentor-pi.dev">Mentor Pi maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>

  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rosidl_runtime_cpp</test_depend>
  <test_depend>rosidl_typesupport_cpp</test_depend>
  <test_depend>rosidl_typesupport_introspection_cpp</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
