#!/usr/bin/env bash

set -uo pipefail

umask 0077

output_directory=""
handoff_directory=""
repository_root=""
qualification_mode="none"
qualification_duration_sec=60
allow_missing_oled=0

Usage() {
  cat >&2 <<'EOF'
Usage: capture_board_diagnostics --output ABSOLUTE_DIRECTORY \
  [--handoff-directory ABSOLUTE_DIRECTORY] \
  [--repository-root ABSOLUTE_DIRECTORY] \
  [--qualification none|strict|imu-characterization] \
  [--qualification-duration-sec 1..600] [--allow-missing-oled]

Create a read-only Mentor Pi diagnostic bundle. The tool never opens the
serial device for transport, publishes a ROS command, changes systemd state,
or flashes firmware. An optional qualification run invokes only the read-only
qualification_monitor modes.
EOF
  exit 2
}

FailUsage() {
  echo "Diagnostic capture argument error: $*" >&2
  Usage
}

while (($# > 0)); do
  case "$1" in
    --output)
      (($# >= 2)) || FailUsage "--output requires a value"
      output_directory="$2"
      shift 2
      ;;
    --handoff-directory)
      (($# >= 2)) || FailUsage "--handoff-directory requires a value"
      handoff_directory="$2"
      shift 2
      ;;
    --repository-root)
      (($# >= 2)) || FailUsage "--repository-root requires a value"
      repository_root="$2"
      shift 2
      ;;
    --qualification)
      (($# >= 2)) || FailUsage "--qualification requires a value"
      qualification_mode="$2"
      shift 2
      ;;
    --qualification-duration-sec)
      (($# >= 2)) ||
        FailUsage "--qualification-duration-sec requires a value"
      qualification_duration_sec="$2"
      shift 2
      ;;
    --allow-missing-oled)
      allow_missing_oled=1
      shift
      ;;
    -h | --help)
      Usage
      ;;
    *)
      FailUsage "unknown argument: $1"
      ;;
  esac
done

[[ "${output_directory}" == /* && "${output_directory}" != "/" ]] ||
  FailUsage "--output must be an absolute non-root path"
[[ "${output_directory}" != *$'\n'* ]] ||
  FailUsage "--output may not contain a newline"
case "${qualification_mode}" in
  none | strict | imu-characterization) ;;
  *) FailUsage "unknown qualification mode: ${qualification_mode}" ;;
esac
if [[ ! "${qualification_duration_sec}" =~ ^[1-9][0-9]{0,2}$ ]] ||
    ((qualification_duration_sec > 600)); then
  FailUsage "qualification duration must be an integer in [1, 600]"
fi
if ((allow_missing_oled == 1)) &&
    [[ "${qualification_mode}" != "imu-characterization" ]]; then
  FailUsage "--allow-missing-oled requires imu-characterization mode"
fi
if [[ -n "${handoff_directory}" ]]; then
  [[ "${handoff_directory}" == /* && -d "${handoff_directory}" ]] ||
    FailUsage "--handoff-directory must be an absolute existing directory"
fi
if [[ -n "${repository_root}" ]]; then
  [[ "${repository_root}" == /* && -d "${repository_root}" ]] ||
    FailUsage "--repository-root must be an absolute existing directory"
fi

readonly ARCHIVE_PATH="${output_directory}.tar.gz"
readonly ARCHIVE_HASH_PATH="${ARCHIVE_PATH}.sha256"
for destination in "${output_directory}" "${ARCHIVE_PATH}" \
    "${ARCHIVE_HASH_PATH}"; do
  if [[ -e "${destination}" || -L "${destination}" ]]; then
    FailUsage "refusing to replace existing path: ${destination}"
  fi
done

if ! mkdir -p "$(dirname "${output_directory}")" ||
    ! mkdir "${output_directory}"; then
  echo "Could not create diagnostic output ${output_directory}." >&2
  exit 1
fi

readonly OUTPUT_DIRECTORY="${output_directory}"
readonly STATUS_FILE="${OUTPUT_DIRECTORY}/command-status.tsv"
readonly TEST_ROOT="${MENTOR_PI_CAPTURE_TEST_ROOT:-}"
readonly STARTED_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
readonly ALLOW_MISSING_OLED="${allow_missing_oled}"
readonly DEVELOPMENT_RUNTIME="${MENTOR_PI_DEVELOPMENT_RUNTIME:-0}"
readonly HOST_PREFIX="${MENTOR_PI_HOST_PREFIX:-/opt/mentor_pi/host}"
readonly AGENT_EXECUTABLE="${MENTOR_PI_AGENT_EXECUTABLE:-/opt/mentor_pi/bin/mentor_pi_micro_ros_agent}"
[[ "${DEVELOPMENT_RUNTIME}" == "0" || "${DEVELOPMENT_RUNTIME}" == "1" ]] || {
  echo "MENTOR_PI_DEVELOPMENT_RUNTIME must be 0 or 1." >&2
  exit 1
}
if [[ "${DEVELOPMENT_RUNTIME}" == "1" ]]; then
  [[ "${HOST_PREFIX}" == /* && "${HOST_PREFIX}" != "/" ]] || {
    echo "MENTOR_PI_HOST_PREFIX must be an absolute non-root path." >&2
    exit 1
  }
  [[ "${AGENT_EXECUTABLE}" == /* ]] || {
    echo "MENTOR_PI_AGENT_EXECUTABLE must be an absolute path." >&2
    exit 1
  }
fi
critical_failure=0
qualification_status="NOT_RUN"

RootPath() {
  printf '%s%s' "${TEST_ROOT}" "$1"
}

RecordStatus() {
  local label="$1"
  local status="$2"
  printf '%s\t%s\n' "${label}" "${status}" >>"${STATUS_FILE}"
}

FormatCommand() {
  printf '$'
  printf ' %q' "$@"
  printf '\n'
}

CaptureCommand() {
  local label="$1"
  shift
  local destination="${OUTPUT_DIRECTORY}/${label}.txt"
  local status=0
  printf 'DIAGNOSTIC CAPTURE: %s\n' "${label}" >&2
  {
    FormatCommand "$@"
    "$@"
  } >"${destination}" 2>&1 || status=$?
  RecordStatus "${label}" "${status}"
}

CaptureTimedCommandWithProgress() {
  local label="$1"
  local seconds="$2"
  local expected_duration="$3"
  shift 3
  local destination="${OUTPUT_DIRECTORY}/${label}.txt"
  local status=0
  local started=${SECONDS}
  local next_report=5
  {
    FormatCommand timeout --signal=INT --kill-after=2 "${seconds}" "$@"
    timeout --signal=INT --kill-after=2 "${seconds}" "$@"
  } >"${destination}" 2>&1 &
  local command_pid=$!
  echo "QUALIFICATION MONITOR: started ${expected_duration}-second observation; detailed output is saved to ${destination}." >&2
  while kill -0 "${command_pid}" 2>/dev/null; do
    sleep 1
    local elapsed=$((SECONDS - started))
    if ((elapsed >= next_report && elapsed < expected_duration)); then
      echo "QUALIFICATION MONITOR: ${elapsed}/${expected_duration} seconds; checking graph, rates, diagnostics, and transport." >&2
      next_report=$((next_report + 5))
    fi
  done
  wait "${command_pid}" || status=$?
  RecordStatus "${label}" "${status}"
}

CaptureTimedCommand() {
  local label="$1"
  local seconds="$2"
  shift 2
  CaptureCommand "${label}" timeout --signal=INT \
    --kill-after=2 "${seconds}" "$@"
}

CaptureKnownFile() {
  local label="$1"
  local source="$2"
  local destination="${OUTPUT_DIRECTORY}/${label}.txt"
  local status=0
  {
    printf 'source=%s\n' "${source}"
    if [[ -f "${source}" && ! -L "${source}" && -r "${source}" ]]; then
      sed -n '1,2000p' "${source}"
    else
      echo "Source is missing, symbolic, non-regular, or unreadable."
      status=1
    fi
  } >"${destination}" 2>&1
  RecordStatus "${label}" "${status}"
}

CaptureManifest() {
  local label="$1"
  local directory="$2"
  local status=0
  {
    printf 'directory=%s\n' "${directory}"
    if [[ ! -f "${directory}/SHA256SUMS" ]]; then
      echo "SHA256SUMS is missing."
      status=1
    else
      (cd "${directory}" && sha256sum --check SHA256SUMS) || status=$?
    fi
  } >"${OUTPUT_DIRECTORY}/${label}.txt" 2>&1
  RecordStatus "${label}" "${status}"
}

printf 'label\texit_status\n' >"${STATUS_FILE}"

CaptureCommand host-date date -u --iso-8601=seconds
CaptureCommand host-uname uname -a
CaptureCommand host-architecture dpkg --print-architecture
CaptureKnownFile host-os-release "$(RootPath /etc/os-release)"
if [[ "${DEVELOPMENT_RUNTIME}" == "1" ]]; then
  CaptureCommand adaptive-runtime-paths ls -ld \
    "${HOST_PREFIX}" "${AGENT_EXECUTABLE}" "$(RootPath /dev/mentor_pi_mcu)"
else
  CaptureCommand installed-paths ls -ld \
    "$(RootPath /opt/mentor_pi/host)" \
    "$(RootPath /opt/mentor_pi/micro_ros_agent)" \
    "$(RootPath /opt/mentor_pi/bin/mentor_pi_micro_ros_agent)" \
    "$(RootPath /dev/mentor_pi_mcu)"
  CaptureCommand installed-link-targets readlink -f \
    "$(RootPath /opt/mentor_pi/host)" \
    "$(RootPath /opt/mentor_pi/micro_ros_agent)" \
    "$(RootPath /dev/mentor_pi_mcu)"
fi

CaptureKnownFile ros-identity "$(RootPath /etc/default/mentor-pi)"
CaptureKnownFile controller-configuration \
  "$(RootPath /etc/mentor-pi/controller.yaml)"
CaptureKnownFile usb-udev-rule \
  "$(RootPath /etc/udev/rules.d/99-mentor-pi-mcu.rules)"

readonly -a SYSTEMD_UNITS=(
  mentor-pi-controller.target
  mentor-pi-runtime.service
  mentor-pi-agent.service
  mentor-pi-configuration-supervisor.service
)
CaptureCommand systemd-active-state systemctl is-active "${SYSTEMD_UNITS[@]}"
CaptureCommand systemd-enabled-state systemctl is-enabled \
  mentor-pi-controller.target
CaptureCommand systemd-status systemctl --no-pager --full status \
  "${SYSTEMD_UNITS[@]}"
CaptureCommand systemd-properties systemctl show \
  --property=Id,LoadState,ActiveState,SubState,Result,MainPID,ExecMainCode,ExecMainStatus,NRestarts,FragmentPath \
  "${SYSTEMD_UNITS[@]}"
CaptureCommand systemd-unit-verification systemd-analyze verify \
  "$(RootPath /etc/systemd/system/mentor-pi-runtime.service)" \
  "$(RootPath /etc/systemd/system/mentor-pi-agent.service)" \
  "$(RootPath /etc/systemd/system/mentor-pi-configuration-supervisor.service)" \
  "$(RootPath /etc/systemd/system/mentor-pi-controller.target)"
CaptureCommand service-journal journalctl --utc --no-pager --output=short-iso \
  --since "15 minutes ago" \
  -u mentor-pi-runtime.service \
  -u mentor-pi-agent.service \
  -u mentor-pi-configuration-supervisor.service

CaptureCommand usb-identity udevadm info --query=property \
  --name="$(RootPath /dev/mentor_pi_mcu)"
CaptureCommand usb-device-stat stat "$(RootPath /dev/mentor_pi_mcu)"
if command -v fuser >/dev/null 2>&1; then
  CaptureCommand serial-owner fuser -v "$(RootPath /dev/mentor_pi_mcu)"
else
  printf '%s\n' 'fuser is not installed.' \
    >"${OUTPUT_DIRECTORY}/serial-owner.txt"
  RecordStatus serial-owner 127
fi

agent_wrapper="$(RootPath /opt/mentor_pi/bin/mentor_pi_micro_ros_agent)"
if [[ "${DEVELOPMENT_RUNTIME}" == "1" ]]; then
  agent_wrapper="${AGENT_EXECUTABLE}"
fi
readonly AGENT_WRAPPER="${agent_wrapper}"
unset agent_wrapper
if [[ -x "${AGENT_WRAPPER}" ]]; then
  CaptureTimedCommand agent-help 10 "${AGENT_WRAPPER}" --help
else
  printf 'Agent wrapper is missing or not executable: %s\n' \
    "${AGENT_WRAPPER}" >"${OUTPUT_DIRECTORY}/agent-help.txt"
  RecordStatus agent-help 127
fi

if [[ -n "${handoff_directory}" ]]; then
  CaptureManifest handoff-root-manifest "${handoff_directory}"
  if [[ -d "${handoff_directory}/firmware-pid-release" ]]; then
    CaptureManifest handoff-pid-release-manifest \
      "${handoff_directory}/firmware-pid-release"
  else
    printf '%s\n' 'The handoff has no firmware-pid-release/ directory.' \
      >"${OUTPUT_DIRECTORY}/handoff-pid-release-manifest.txt"
    RecordStatus handoff-pid-release-manifest 1
  fi
  CaptureKnownFile handoff-metadata "${handoff_directory}/HANDOFF.txt"
  CaptureKnownFile handoff-build-mode \
    "${handoff_directory}/firmware-pid-release/BUILD-MODE.txt"
  CaptureKnownFile firmware-build-metadata \
    "${handoff_directory}/firmware-pid-release/BUILD-METADATA.txt"
fi

if [[ -n "${repository_root}" ]]; then
  readonly FIRMWARE_VERIFIER="${repository_root}/tools/verify_firmware_artifact.sh"
  if [[ -x "${FIRMWARE_VERIFIER}" ]]; then
    CaptureTimedCommand authoritative-firmware-verification 120 \
      "${FIRMWARE_VERIFIER}" PID "${repository_root}"
  else
    printf 'Firmware verifier is missing or not executable: %s\n' \
      "${FIRMWARE_VERIFIER}" \
      >"${OUTPUT_DIRECTORY}/authoritative-firmware-verification.txt"
    RecordStatus authoritative-firmware-verification 127
  fi
  if [[ -n "${handoff_directory}" ]]; then
    CaptureCommand handoff-authoritative-elf-compare cmp \
      "${repository_root}/firmware/mentor_pi_mcu/build/stm32/mentor_pi_mcu.elf" \
      "${handoff_directory}/firmware-pid-release/mentor_pi_mcu-firmware-pid-release.elf"
    CaptureCommand handoff-authoritative-metadata-compare cmp \
      "${repository_root}/firmware/mentor_pi_mcu/build/stm32/rrclite-build-metadata.txt" \
      "${handoff_directory}/firmware-pid-release/BUILD-METADATA.txt"
  fi
fi

ros_ready=1
readonly ROS_IDENTITY="$(RootPath /etc/default/mentor-pi)"
ros_setup="$(RootPath /opt/mentor_pi/host/setup.bash)"
if [[ "${DEVELOPMENT_RUNTIME}" == "1" ]]; then
  ros_setup="${HOST_PREFIX}/setup.bash"
fi
readonly ROS_SETUP="${ros_setup}"
unset ros_setup
ros_domain_id=""
if [[ "${DEVELOPMENT_RUNTIME}" == "1" ]]; then
  ros_domain_id="${ROS_DOMAIN_ID:-}"
  if [[ ! "${ros_domain_id}" =~ ^(0|[1-9][0-9]{0,2})$ ]] ||
      ((ros_domain_id > 232)); then
    ros_ready=0
  fi
else
if [[ -f "${ROS_IDENTITY}" && ! -L "${ROS_IDENTITY}" ]]; then
  active_identity="$(grep -Ev '^[[:space:]]*(#|$)' \
    "${ROS_IDENTITY}" 2>/dev/null || true)"
  if [[ "${active_identity}" =~ ^ROS_DOMAIN_ID=(0|[1-9][0-9]{0,2})$ ]]; then
    ros_domain_id="${active_identity#ROS_DOMAIN_ID=}"
    if ((ros_domain_id > 232)); then
      ros_ready=0
    fi
  else
    ros_ready=0
  fi
else
  ros_ready=0
fi
fi
if [[ ! -r "${ROS_SETUP}" ]]; then
  ros_ready=0
fi
if ! command -v timeout >/dev/null 2>&1; then
  ros_ready=0
fi

if ((ros_ready == 1)); then
  export ROS_DOMAIN_ID="${ros_domain_id}"
  # Generated ROS setup hooks are not guaranteed to be nounset-clean. They are
  # sourced only for read-only ROS graph subscriptions in this finite tool.
  set +u
  # shellcheck disable=SC1090
  source "${ROS_SETUP}"
  setup_status=$?
  set -u
  if ((setup_status != 0)) || ! command -v ros2 >/dev/null 2>&1; then
    ros_ready=0
  fi
fi

if ((ros_ready == 0)); then
  critical_failure=1
  {
    echo "Read-only ROS capture was skipped because the production ROS identity,"
    echo "host setup, timeout command, or ros2 executable is invalid/missing."
  } >"${OUTPUT_DIRECTORY}/ros-capture-skipped.txt"
  RecordStatus ros-capture-skipped 1
else
  {
    printf 'ROS_DOMAIN_ID=%s\n' "${ROS_DOMAIN_ID}"
    printf 'RMW_IMPLEMENTATION=%s\n' "${RMW_IMPLEMENTATION:-DEFAULT}"
    printf 'ROS_LOCALHOST_ONLY=%s\n' "${ROS_LOCALHOST_ONLY:-DEFAULT}"
  } >"${OUTPUT_DIRECTORY}/ros-environment.txt"
  RecordStatus ros-environment 0

  CaptureTimedCommand ros-node-list 10 ros2 node list \
    --no-daemon --spin-time 2.0
  CaptureTimedCommand ros-topic-list 10 ros2 topic list \
    --no-daemon --spin-time 2.0 --types
  CaptureTimedCommand ros-service-list 10 ros2 service list \
    --no-daemon --spin-time 2.0 --types
  CaptureTimedCommand ros-controller-node 10 ros2 node info \
    --no-daemon --spin-time 2.0 /mentor_pi/controller
  CaptureTimedCommand ros-supervisor-node 10 ros2 node info \
    --no-daemon --spin-time 2.0 /mentor_pi/configuration_supervisor

  readonly -a GRAPH_TOPICS=(
    /mentor_pi/heartbeat
    /mentor_pi/diagnostics
    /mentor_pi/motors/state
    /mentor_pi/pwm_servos/state
    /mentor_pi/imu
    /mentor_pi/battery/state
    /mentor_pi/buttons/events
    /mentor_pi/motors/command
    /mentor_pi/configuration/motion_enabled
    /mentor_pi/configuration/motion_authorization
  )
  graph_topic=""
  graph_index=0
  for graph_topic in "${GRAPH_TOPICS[@]}"; do
    printf -v graph_label 'ros-topic-info-%02d' "${graph_index}"
    CaptureTimedCommand "${graph_label}" 10 ros2 topic info \
      --no-daemon --spin-time 2.0 "${graph_topic}" --verbose
    ((graph_index += 1))
  done

  CaptureTimedCommand ros-heartbeat-sample 5 ros2 topic echo \
    /mentor_pi/heartbeat --once --qos-reliability reliable
  CaptureTimedCommand ros-diagnostics-sample 5 ros2 topic echo \
    /mentor_pi/diagnostics --once --qos-reliability reliable
  CaptureTimedCommand ros-motor-state-sample 5 ros2 topic echo \
    /mentor_pi/motors/state --once --qos-reliability best_effort
  CaptureTimedCommand ros-pwm-state-sample 5 ros2 topic echo \
    /mentor_pi/pwm_servos/state --once --qos-reliability best_effort
  CaptureTimedCommand ros-imu-sample 5 ros2 topic echo \
    /mentor_pi/imu --once --qos-reliability best_effort
  CaptureTimedCommand ros-battery-sample 5 ros2 topic echo \
    /mentor_pi/battery/state --once --qos-reliability reliable
  CaptureTimedCommand ros-motion-enabled-sample 5 ros2 topic echo \
    /mentor_pi/configuration/motion_enabled --once \
    --qos-reliability reliable --qos-durability transient_local
  CaptureTimedCommand ros-motion-authorization-sample 5 ros2 topic echo \
    /mentor_pi/configuration/motion_authorization --once \
    --qos-reliability reliable --qos-durability transient_local

  if [[ "${qualification_mode}" != "none" ]]; then
    readonly QUALIFICATION_TIMEOUT_SEC=$((qualification_duration_sec + 30))
    qualification_arguments=(
      ros2 run mentor_pi_bringup qualification_monitor --ros-args
      -p "duration_sec:=${qualification_duration_sec}.0"
    )
    if [[ "${qualification_mode}" == "imu-characterization" ]]; then
      qualification_arguments+=( -p imu_characterization_mode:=true )
      if ((ALLOW_MISSING_OLED == 1)); then
        qualification_arguments+=( -p allow_missing_oled:=true )
      fi
    fi
    CaptureTimedCommandWithProgress qualification \
      "${QUALIFICATION_TIMEOUT_SEC}" "${qualification_duration_sec}" \
      "${qualification_arguments[@]}"
    qualification_status="$(tail -n 1 "${STATUS_FILE}" | cut -f2)"
    echo "Qualification result:" >&2
    awk '
      /CHARACTERIZATION (PASS|FAIL)|PREFLIGHT (PASS|FAIL)/ { printing = 1 }
      printing && !/^\[ros2run\]:/ { print }
    ' "${OUTPUT_DIRECTORY}/qualification.txt" >&2 || \
      tail -n 20 "${OUTPUT_DIRECTORY}/qualification.txt" >&2
    if [[ "${qualification_status}" != "0" ]]; then
      critical_failure=1
    fi
  fi
fi

readonly COMPLETED_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
overall_result="CAPTURE_COMPLETE"
if ((critical_failure != 0)); then
  overall_result="CAPTURE_COMPLETE_WITH_FAILURE"
fi
cat >"${OUTPUT_DIRECTORY}/SUMMARY.txt" <<EOF
capture_schema=mentor-pi-board-diagnostics-v1
started_utc=${STARTED_UTC}
completed_utc=${COMPLETED_UTC}
result=${overall_result}
qualification_mode=${qualification_mode}
qualification_duration_sec=${qualification_duration_sec}
qualification_exit_status=${qualification_status}
oled_missing_allowed=${ALLOW_MISSING_OLED}
development_runtime=${DEVELOPMENT_RUNTIME}
serial_transport_opened=0
ros_command_published=0
system_state_changed=0
firmware_flashed=0
EOF

(
  cd "${OUTPUT_DIRECTORY}" || exit 1
  while IFS= read -r -d '' evidence_file; do
    sha256sum "${evidence_file}"
  done < <(find . -type f ! -name SHA256SUMS -print0 | sort -z)
) >"${OUTPUT_DIRECTORY}/SHA256SUMS"
manifest_status=$?
if ((manifest_status != 0)); then
  echo "Could not write the evidence manifest." >&2
  critical_failure=1
else
  (cd "${OUTPUT_DIRECTORY}" && sha256sum --check SHA256SUMS >/dev/null) ||
    critical_failure=1
fi

archive_status=0
tar -C "$(dirname "${OUTPUT_DIRECTORY}")" -czf "${ARCHIVE_PATH}" -- \
  "$(basename "${OUTPUT_DIRECTORY}")" || archive_status=$?
if ((archive_status == 0)); then
  (
    cd "$(dirname "${ARCHIVE_PATH}")" || exit 1
    sha256sum -- "$(basename "${ARCHIVE_PATH}")"
  ) >"${ARCHIVE_HASH_PATH}" || archive_status=$?
fi
if ((archive_status != 0)); then
  echo "Could not create the compressed evidence archive." >&2
  critical_failure=1
fi

if [[ "$(id -u)" == "0" && "${SUDO_UID:-}" =~ ^[1-9][0-9]*$ &&
      "${SUDO_GID:-}" =~ ^[1-9][0-9]*$ ]]; then
  chown -R "${SUDO_UID}:${SUDO_GID}" "${OUTPUT_DIRECTORY}" ||
    critical_failure=1
  if [[ -f "${ARCHIVE_PATH}" ]]; then
    chown "${SUDO_UID}:${SUDO_GID}" "${ARCHIVE_PATH}" ||
      critical_failure=1
  fi
  if [[ -f "${ARCHIVE_HASH_PATH}" ]]; then
    chown "${SUDO_UID}:${SUDO_GID}" "${ARCHIVE_HASH_PATH}" ||
      critical_failure=1
  fi
fi

echo "Mentor Pi diagnostic evidence: ${OUTPUT_DIRECTORY}"
if [[ -f "${ARCHIVE_PATH}" ]]; then
  echo "Shareable archive after review: ${ARCHIVE_PATH}"
  echo "Archive digest: ${ARCHIVE_HASH_PATH}"
fi
echo "No serial transport was opened and no ROS command was published."
if ((critical_failure != 0)); then
  echo "Capture completed with a prerequisite or qualification failure." >&2
  echo "Review SUMMARY.txt, command-status.tsv, and the individual logs." >&2
  exit 1
fi
echo "Capture completed. Review the bundle for site-sensitive data before sharing."
