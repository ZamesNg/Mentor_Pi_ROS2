<?xml version="1.0"?>
<package format="3">
  <name>mentor_pi_bringup</name>
  <version>0.1.0</version>
  <description>
    Native Agent deployment assets, C++ configuration supervisor, and safe
    hardware qualification monitor and bounded campaign harness for Mentor Pi
    controller v2.
  </description>
  <maintainer email="maintainers@example.com">Mentor Pi Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mentor_pi_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
