#!/usr/bin/env bash

set -euo pipefail

readonly ROS_SETUP="/opt/ros/humble/setup.bash"
readonly AGENT_ROOT="/opt/mentor_pi/micro_ros_agent"
readonly AGENT_EXECUTABLE="${AGENT_ROOT}/lib/micro_ros_agent/micro_ros_agent"
readonly SERIAL_LOCK="/run/mentor-pi/serial.lock"

ValidateRosIdentity() {
  # The installer invokes only the non-transport help path before a deployment
  # identity exists. Every serial invocation, including interactive diagnosis,
  # must receive an explicit domain from its caller.
  if [[ "${1:-}" != "serial" && -z "${ROS_DOMAIN_ID:-}" ]]; then
    return
  fi
  if [[ ! "${ROS_DOMAIN_ID:-}" =~ ^(0|[1-9][0-9]{0,2})$ ]] ||
      ((ROS_DOMAIN_ID > 232)); then
    echo "ROS_DOMAIN_ID must be explicitly set to an integer in [0, 232]." \
      >&2
    exit 1
  fi
}

if [[ ! -r "${ROS_SETUP}" || ! -r "${AGENT_ROOT}/setup.bash" ||
      ! -x "${AGENT_EXECUTABLE}" ]]; then
  echo "Pinned Mentor Pi micro-ROS Agent installation is incomplete." >&2
  echo "Run sudo ./tools/install_microros_agent.sh first." >&2
  exit 1
fi

set +u
source "${ROS_SETUP}"
source "${AGENT_ROOT}/setup.bash"
set -u

ValidateRosIdentity "$@"
if [[ "${1:-}" == "serial" ]]; then
  # RRCLite routes CH9102F DTR/RTS through its STM32 reset/BOOT0 circuit. The
  # project-patched Agent consumes this opt-in and performs a normal-boot reset
  # sequence on the same descriptor before starting XRCE traffic.
  export MENTOR_PI_RRCLITE_AUTORESET=1
  if ! exec {serial_lock_fd}>"${SERIAL_LOCK}"; then
    echo "Cannot open the production serial lock ${SERIAL_LOCK}." >&2
    echo "Stop mentor-pi-agent.service before interactive serial use." >&2
    exit 1
  fi
  if ! /usr/bin/flock -n "${serial_lock_fd}"; then
    echo "Another Mentor Pi Agent owns the serial transport." >&2
    exit 1
  fi
fi
exec "${AGENT_EXECUTABLE}" "$@"
