# Local legacy evidence. Track only its policy; the v2 build must not depend on
# the raw snapshot.
docs/reference/*
!docs/reference/README.md

# macOS metadata.
.DS_Store
**/.DS_Store
__pycache__/
*.pyc

# ROS 2 / colcon outputs.
build/
install/
log/
*.log

# CMake and native test outputs.
cmake-build-*/
**/cmake-build-*/
Testing/

# Obsolete PlatformIO caches; PlatformIO is not an active build path.
.pio/
**/.pio/

# Local inspection and rendering scratch space.
tmp/

# Downloaded firmware dependencies and extracted micro-ROS SDK.
firmware/mentor_pi_mcu/third_party/
firmware/mentor_pi_mcu/generated/
firmware/mentor_pi_mcu/.deps/
firmware/mentor_pi_mcu/build/
micro_ros_agent/build/
ros2_ws/third_party/*
