<?xml version="1.0"?>
<robot name="mentor_pi_hardwares_ackermann_simulation" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="mentor_pi_sim"/>

  <xacro:include filename="$(find mentor_pi_hardwares)/config/ackermann/description.urdf.xacro"/>
  <xacro:include filename="$(find mentor_pi_hardwares)/config/ackermann/simulation_ros2_control.xacro"/>

  <xacro:ackermann_car frame_prefix="$(arg robot_name)/"/>
  <xacro:ackermann_simulation_control robot_name="$(arg robot_name)"/>

</robot>
