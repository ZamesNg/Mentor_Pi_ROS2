@@ -15,8 +15,64 @@
 #include <uxr/agent/transport/serial/TermiosAgentLinux.hpp>
 
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
 #include <fcntl.h>
+#include <sys/ioctl.h>
+#include <thread>
 #include <unistd.h>
 
+namespace {
+
+constexpr char rrclite_autoreset_environment[] =
+        "MENTOR_PI_RRCLITE_AUTORESET";
+
+bool rrclite_autoreset_enabled()
+{
+    const char* value = std::getenv(rrclite_autoreset_environment);
+    return nullptr != value && 0 == std::strcmp(value, "1");
+}
+
+bool set_modem_bits(
+        int fd,
+        unsigned long request,
+        int bits)
+{
+    return 0 == ioctl(fd, request, &bits);
+}
+
+bool reset_rrclite_into_application(
+        int fd)
+{
+    // RRCLite connects CH9102F DTR/RTS to an automatic STM32 reset/BOOT0
+    // circuit. A normal tty open asserts both signals and can leave the MCU in
+    // its ROM bootloader. The hardware-verified sequence is:
+    //   DTR clear, RTS set   -> NRST asserted
+    //   DTR clear, RTS clear -> BOOT0 low before NRST is released
+    // Keep the reset pulse long enough for the board circuit and then allow
+    // the application to initialize before serial input is flushed.
+    int bits = TIOCM_RTS;
+    if (!set_modem_bits(fd, TIOCMBIS, bits))
+    {
+        return false;
+    }
+    bits = TIOCM_DTR;
+    if (!set_modem_bits(fd, TIOCMBIC, bits))
+    {
+        return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    bits = TIOCM_RTS;
+    if (!set_modem_bits(fd, TIOCMBIC, bits))
+    {
+        return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    return true;
+}
+
+} // namespace
+
